# Where data comes from. `mock` renders entirely from fixtures — no backend,
# no network. `live` sends contract-served operations to the Go API in the
# Banking-backend repo (see src/lib/api/endpoints/registry.ts for which); the
# rest still resolve to fixtures behind the same signatures.
NEXT_PUBLIC_API_MODE=mock

# Same-origin prefix the browser calls. Requests to it hit the BFF proxy at
# src/app/api/[...path]/route.ts, which attaches auth server-side.
NEXT_PUBLIC_API_BASE_URL=/api

NEXT_PUBLIC_API_TIMEOUT_MS=15000

# The Go API (Banking-backend). Server-only — no NEXT_PUBLIC_ prefix, so the
# real backend URL is never shipped to the client. The backend defaults to
# port 4000 precisely to stay clear of this dev server on 3000.
API_INTERNAL_URL=http://localhost:4000
